{
  "name": "@capivara/core",
  "version": "0.9.0-RC1",
  "description": "Motores novos de desenvolvimento por fragmentos: init, plan e build",
  "type": "module",
  "bin": {
    "capivara": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs && tsc --emitDeclarationOnly --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "releaseVersion": "0.9.0_RC1",
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "types": "./dist/index.d.ts"
}
